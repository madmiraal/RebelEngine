#!/usr/bin/env python

Import("env")
Import("env_modules")

env_raycast = env_modules.Clone()

if env["builtin_embree"]:
    import glob
    import os
    import shutil
    import subprocess

    def cmake_build(target, source, env):
        if "LIBRARY_PATH" not in env:
            print("Error: 'LIBRARY_PATH' is not defined in env")
            return
        library_path = env["LIBRARY_PATH"]
        configure_command = ["cmake", "-B", "build"]
        if "CMAKE_OPTIONS" in env:
            configure_command = configure_command + env["CMAKE_OPTIONS"]
        build_command = ["cmake", "--build", "build"]

        subprocess.run(configure_command, cwd=library_path)
        subprocess.run(build_command, cwd=library_path)

        for entry in target:
            library_file = os.path.join(
                library_path, "build", os.path.basename(str(entry))
            )
            shutil.move(library_file, library_path)

    def get_source_files(directory):
        source = glob.glob(os.path.join(directory, "**/*.cpp"), recursive=True)
        # Exclude files in build directory.
        build = glob.glob(os.path.join(directory, "build/**/*.cpp"), recursive=True)
        source = list(set(source) - set(build))
        return source

    # Build embree library.
    embree_directory = "#third-party/embree/"
    embree_path = str(Entry(embree_directory))
    embree_build_path = os.path.join(embree_path, "build")
    if GetOption("clean") and os.path.isdir(embree_build_path):
        shutil.rmtree(embree_build_path)
        print("Removed", embree_build_path)

    # Order determines link order.
    embree_libraries = [
        "libembree4.a",
        "libembree_avx2.a",
        "libembree_avx.a",
        "libembree_sse42.a",
        "libsimd.a",
        "libtasking.a",
        "liblexers.a",
        "libmath.a",
        "libsys.a",
    ]
    embree_sources = get_source_files(embree_path)
    embree_targets = []
    for embree_library in embree_libraries:
        embree_targets.append(os.path.join(embree_directory, embree_library))
    embree_env = env_modules.Clone()
    embree_env.disable_warnings()
    embree_env.Append(LIBRARY_PATH=embree_path)
    embree_env.Append(
        CMAKE_OPTIONS=[
            "-DEMBREE_STATIC_LIB=ON",
            "-DEMBREE_TASKING_SYSTEM=INTERNAL",
            "-DEMBREE_MAX_ISA=AVX2",
            "-DEMBREE_TUTORIALS=OFF",
        ]
    )
    if env["use_llvm"]:
        embree_env.Append(
            CMAKE_OPTIONS=[
                "-DCMAKE_C_COMPILER=clang",
                "-DCMAKE_CXX_COMPILER=clang++",
            ]
        )
    embree_env.Command(embree_targets, embree_sources, cmake_build)

    # Add embree library dependencies.
    env_raycast.Append(CPPPATH=[os.path.join(embree_directory, "include")])
    env.Append(LIBS=embree_libraries)
    env.Append(LIBPATH=[embree_directory])

    if env["platform"] == "windows":
        if env.msvc:
            env.Append(LINKFLAGS=["psapi.lib"])
        else:
            env.Append(LIBS=["psapi"])


# Build raycast module.
module_obj = []
env_raycast.add_source_files(module_obj, "*.cpp")
env.modules_sources += module_obj
